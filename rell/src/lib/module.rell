module;

/**
 * Stores a vector in the database. For performance consider using `store_vectors` instead.
 *
 * @param collection Name of collection.
 * @param context The context of the vector.
 * @param vector The vector to store.
 * @param id The id of the vector, this is the id to be returned from a search.
 */
function store_vector(collection: text, context: integer, vector: text, id: integer) {
    store_vectors(collection, context, [vector_db_data(vector, id)]);
}

/**
 * Struct used to store vectors and id when sent to store_vectors as list.
 */
struct vector_db_data {
    /** A vector string on format '[0.0,...]' */
    vector: text;

    /** The reference ID for this vector, */
    id: integer;
}

/**
 * Store a list of vectors in the database.
 *
 * @param collection The name of the collection defined in the blockchain configuration.
 * @param context The context of the vector.
 * @param vectors List of vectors to store.
 */
function store_vectors(collection: text, context: integer, vectors: list<vector_db_data>) {
    op_context.emit_event("store_vectors", (collection = collection, context = context, vectors = vectors).to_gtv_pretty());
}

/**
 * Delete one vector from database. For performance consider using `delete_vectors` instead.
 *
 * @param collection The name of the collection defined in the blockchain configuration.
 * @param context The context of the vector.
 * @param id The ID for the vector to delete.
 */
function delete_vector(collection: text, context: integer, id: integer) {
    delete_vectors(collection, context, set([id]));
}

/**
 * Delete a set of vectors from the database.
 *
 * @param collection The name of the collection defined in the blockchain configuration.
 * @param context The context of the vector.
 * @param ids The list of vector IDs to delete.
 */
function delete_vectors(collection: text, context: integer, ids: set<integer>) {
    op_context.emit_event("delete_vectors", (collection = collection, context = context, ids = ids).to_gtv_pretty());
}

/** A vector search result object. The query template function gets a list of this object. */
struct object_distance {
    context: integer;
    id: integer;
    distance: decimal;
}