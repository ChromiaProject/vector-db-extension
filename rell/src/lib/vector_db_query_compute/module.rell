module;

import hc: lib.hybridcompute.*;

val my_type = "vector-db-query";

/** Input for query compute similar to the ordinary vector db query, but with no support for templates */
struct query_request {
    collection: text;
    q_vector: text;
    max_distance: decimal;
    context: integer? =  null;
    query_max_vectors: integer? = null;
}

/** Represents one vector hit */
struct query_result_object {
    /** The vectors reference ID */
    id: integer;

    /** The vectors context ID */
    context: integer;

    /** Distance from q_vector, as decimal value in text */
    distance: text;
}

struct query_result {
    /** The result of the query, or null if an error occurred. */
    result: list<query_result_object>?;

    /** An error message if the query request failed, or null if no error occurred. */
    error: text?;

    /** RID of the transaction where the result was reported. */
    tx_rid: byte_array;

    /** Index of the operation where the result was reported. */
    op_index: integer;
}

// Force generation of code for the structs
query vdbqc_bogus(query_request) = query_result(result = null, error = null, x"", 0);

/**
 * Submits a closest objects query to be processed asynchronously. Extend `on_query_result` to get the result when it is ready.
 *
 * @param id Unique ID for this query compute request.
 * @param collection The name of the collection.
 * @param q_vector The vector to search closest to, as a string. For example, `[0.1, 0.2, 0.3]`.
 * @param max_distance The maximum distance for vectors to include in the closest search.
 * @param max_vectors The limit of hits to return.
 * @param context The context of the vector, or null to disable this filter.
 */
function submit_query_request(
    id: text,
    collection: text,
    q_vector: text,
    max_distance: decimal,
    query_max_vectors: integer? = null,
    context: integer? = null
) {
    create compute_request_height(height = op_context.block_height, id, collection);
    val input = query_request(collection, q_vector, max_distance, context = context, query_max_vectors = query_max_vectors);
    hc.submit_compute_request(id, my_type, input.to_gtv_pretty());
}

@extend(hc.on_compute_result)
function (id: text, type: text, result: hc.compute_result) {
    if (type != my_type) return;

    on_query_result(id, build_query_result(result));
}

/**
 * Called when an query is finished, successfully or failed.
 *
 * @param id The identifier of the inference request
 * @param query_result The result
 */
@extendable function on_query_result(id: text, query_result: query_result) {}

/**
 * Fetches the result of a previously submitted query request.
 *
 * @param id The identifier of the query request for which the result is being fetched.
 * @return The result, or `null` if not ready yet
 */
function fetch_query_result(id: text): query_result? {
    val result = hc.fetch_compute_result(id);
    if (result == null) return null;
    return build_query_result(result);
}

function build_query_result(result: hc.compute_result) {
    return query_result(
        result = if (result.result != null) list<query_result_object>.from_gtv_pretty(result.result) else null,
        error = result.error,
        tx_rid = result.tx_rid,
        op_index = result.op_index
    );
}
