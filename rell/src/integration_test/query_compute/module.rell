module;

import vdbq: lib.vector_db_query_compute.*;

import vector_example.*;

operation submit_query_request(
    id: text,
    q_vector: text,
    max_distance: decimal,
    max_vectors: integer? = null
) {
    vdbq.submit_query_request(id, COLLECTION, q_vector, max_distance, max_vectors, null);
}

entity query_result {
    id: text;
    result: byte_array;
}

@extend(vdbq.on_query_result)
function (id: text, query_result: vdbq.query_result) {
    log("Query computation for query ID %s completed.".format(id));

    create query_result(id, query_result.to_bytes());
}


query get_query_result(id: text): vdbq.query_result? =
    query_result @? { id } ( vdbq.query_result.from_gtv(gtv.from_bytes(.result)) );
