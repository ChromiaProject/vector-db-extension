function store_vector(context: integer, vector: text, id: integer) {
    op_context.emit_event("store_vector", (context, vector, id).to_gtv());
}

function delete_vector(context: integer, id: integer) {
    op_context.emit_event("delete_vector", (context, id).to_gtv());
}
</string>
